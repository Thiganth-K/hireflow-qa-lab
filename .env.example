# HireFlow QA Lab - Environment Configuration Template
# Copy this file to .env.local for local development and testing

# MongoDB Connection URI
# When provided, HireFlow utilizes native MongoDB with compound unique index enforcement:
# { normalizedEmail: 1, jobId: 1 } (unique: true)
# When omitted or unreachable, HireFlow falls back to concurrent-safe serialized file storage.
MONGODB_URI=mongodb://127.0.0.1:27017/hireflow

# Administrator Secret Key for Protected Application Management Endpoints
# Required to access GET /api/applications (applicant PII listing)
ADMIN_API_KEY=hireflow-test-admin-secret-key-2026
